postmaster.pid
server.log
postgres.log

# Variables de entorno y credenciales privadas
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
id_rsa
id_ed25519

# Archivos temporales y cachés
*.tmp
*.temp
*~
.DS_Store
Thumbs.db
Desktop.ini

# Editores y entornos de desarrollo
.vscode/
.idea/
*.suo
*.user
node_modules/
scripts/node_modules/
scripts/package*.json
