# Binarios de PostgreSQL portátil
pgsql/
*.zip
*.tar
*.gz

# Directorios de datos físicos y bases de datos locales
data/
pgdata/
pgadmin_data/
*.db
*.sqlite
*.sql.dump
*.backup

# Archivos de estado, procesos y logs del servidor
*.log
